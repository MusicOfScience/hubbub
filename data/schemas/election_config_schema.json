{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Election Configuration",
  "type": "object",
  "required": ["election_id", "electorate", "state", "level", "election_date", "enrolled_voters", "tcp_candidates", "candidates"],
  "properties": {
    "election_id": {"type": "string", "minLength": 1},
    "electorate": {"type": "string", "minLength": 1},
    "state": {"type": "string", "enum": ["New South Wales", "Victoria", "Queensland", "South Australia", "Western Australia", "Tasmania", "Northern Territory", "Australian Capital Territory"]},
    "level": {"type": "string", "enum": ["federal", "state", "local"]},
    "election_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "enrolled_voters": {"type": "integer", "minimum": 1},
    "previous_election_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "tcp_candidates": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 2,
      "maxItems": 2
    },
    "candidates": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["candidate_id", "name", "party", "party_abbrev", "colour"],
        "properties": {
          "candidate_id": {"type": "string"},
          "name": {"type": "string"},
          "party": {"type": "string"},
          "party_abbrev": {"type": "string", "maxLength": 10},
          "colour": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}
        }
      }
    },
    "vote_type_estimates": {
      "type": "object",
      "properties": {
        "ordinary_booth": {"type": "integer", "minimum": 0},
        "pre_poll": {"type": "integer", "minimum": 0},
        "postal": {"type": "integer", "minimum": 0},
        "absent": {"type": "integer", "minimum": 0},
        "provisional": {"type": "integer", "minimum": 0}
      }
    }
  }
}
